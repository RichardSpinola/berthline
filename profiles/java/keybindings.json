[
    // Java only; the Hub adds these after profiles/base/keybindings.json
    { "key": "shift+f10", "command": "ij.runSelected", "when": "editorLangId == java || ij.temConfig" },
    { "key": "ctrl+shift+f10", "command": "ij.run", "when": "editorLangId == java" },
    { "key": "shift+f9", "command": "ij.debugSelected", "when": "editorLangId == java || ij.temConfig" },
    { "key": "ctrl+shift+f9", "command": "java.workspace.compile" },
    { "key": "alt+insert", "command": "ij.newClass", "when": "explorerViewletFocus" },
    { "key": "ctrl+alt+shift+n", "command": "ij.newProject" },
    {"key": "ctrl+2", "command": "ij.stop", "when": "inDebugMode || ij.emExecucao"},
    {"key": "ctrl+5", "command": "ij.rerun", "when": "inDebugMode"},
    {"key": "ctrl+5", "command": "ij.runSelected", "when": "(editorLangId == java || ij.temConfig) && !inDebugMode"},
    {"key": "ctrl+5", "command": "ij.rerun", "when": "ij.rodando && !inDebugMode"},
    {"key": "shift+f10", "command": "ij.rerun", "when": "!inDebugMode && terminalFocus"},
    {"key": "ctrl+6", "command": "ij.changeSignature", "when": "editorLangId == java"},
    {"key": "ctrl+f6", "command": "ij.changeSignature", "when": "editorLangId == java"},
    {"key": "ctrl+7", "command": "ij.findInFile", "when": "editorTextFocus"},
    {"key": "ctrl+9", "command": "java.workspace.compile"},
    {"key": "shift+alt+7", "command": "ij.findUsages", "when": "editorTextFocus"},
    {"key": "shift+alt+8", "command": "ij.evaluate", "when": "inDebugMode"},
    {"key": "ctrl+alt+n", "command": "ij.inline", "when": "editorLangId == java"},
    {"key": "shift+alt+v", "command": "ij.extractVariable", "when": "editorLangId == java"},
    {"key": "alt+shift+f10", "command": "ij.runConfigs"},
    {"key": "alt+shift+f9", "command": "ij.runConfigs"},
    {"key": "ctrl+alt+shift+c", "command": "java.action.copyFullyQualifiedName", "when": "editorTextFocus"},
    {"key": "ctrl+alt+insert", "command": "ij.newClassTop"},
    {"key": "alt+up", "command": "ij.prevMethod", "when": "editorLangId == java && editorTextFocus"},
    {"key": "alt+down", "command": "ij.nextMethod", "when": "editorLangId == java && editorTextFocus"},
    {"key": "alt+delete", "command": "ij.safeDelete", "when": "explorerViewletFocus && !inputFocus"}
]
