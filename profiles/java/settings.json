{
    "workbench.colorTheme": "Islands Dark",
    "editor.semanticTokenColorCustomizations": {
        "[Islands Dark]": {
            "rules": {
                "property.static": {
                    "foreground": "#C77DBB",
                    "fontStyle": "italic"
                },
                "method.static": {
                    "fontStyle": "italic"
                },
                "property": "#C77DBB"
            }
        }
    },
    "workbench.colorCustomizations": {
        "[Islands Dark]": {
            "titleBar.activeBackground": "#26282C",
            "titleBar.inactiveBackground": "#26282C",
            "activityBar.background": "#26282C",
            "statusBar.background": "#26282C",
            "statusBar.noFolderBackground": "#26282C",
            "sideBar.background": "#191A1C",
            "sideBarSectionHeader.background": "#191A1C",
            "panel.background": "#191A1C",
            "terminal.background": "#191A1C",
            "editorGroupHeader.tabsBackground": "#191A1C",
            "tab.inactiveBackground": "#191A1C",
            "sideBar.border": "#26282C",
            "panel.border": "#26282C",
            "titleBar.border": "#26282C",
            "activityBar.border": "#26282C",
            "statusBar.border": "#26282C",
            "editorGroup.border": "#26282C",
            "editor.lineHighlightBackground": "#1F2024",
            "editor.stackFrameHighlightBackground": "#2E4D89",
            "editor.focusedStackFrameHighlightBackground": "#2E4D89",
            "editorInlayHint.foreground": "#7A7E85",
            "editor.inlineValuesForeground": "#7A7E85",
            "editor.inlineValuesBackground": "#00000000",
            "editorLineNumber.activeForeground": "#BCBEC4",
            "tab.activeBackground": "#233558",
            "tab.activeBorder": "#00000000",
            "tab.border": "#191A1C",
            "tab.activeForeground": "#FFFFFF"
        }
    },
    "workbench.iconTheme": "jetbrains-file-icon-theme-auto",
    "workbench.productIconTheme": "jetbrains-product-icon-theme",
    "editor.fontFamily": "JetBrains Mono",
    "editor.lineHeight": 1.2,
    "editor.fontLigatures": false,
    "terminal.integrated.fontFamily": "JetBrains Mono",
    "java.server.launchMode": "Standard",
    "workbench.editor.customLabels.enabled": true,
    "workbench.editor.customLabels.patterns": {
        "**/*.java": "${filename}"
    },
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -Xlog:disable -XX:TieredStopAtLevel=1",
    "java.maxConcurrentBuilds": 2,
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/out/**"
    ],
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.generatesMetadataFilesAtProjectRoot": false,
    "java.project.referencedLibraries": [
        "lib/**/*.jar"
    ],
    "java.saveActions.organizeImports": true,
    "java.updateImportsOnPaste.enabled": true,
    "java.sources.organizeImports.starThreshold": 5,
    "java.sources.organizeImports.staticStarThreshold": 3,
    "java.completion.importOrder": [
        "",
        "javax",
        "java",
        "#"
    ],
    "java.completion.chain.enabled": true,
    "java.completion.postfix.enabled": false,
    "java.completion.maxResults": 50,
    "java.completion.filteredTypes": [
        "java.awt.List",
        "com.sun.*",
        "sun.*",
        "jdk.*",
        "org.graalvm.*",
        "io.micrometer.shaded.*"
    ],
    "java.completion.matchCase": "off",
    "java.inlayHints.parameterNames.enabled": "literals",
    "java.inlayHints.variableTypes.enabled": true,
    "java.inlayHints.parameterTypes.enabled": true,
    "java.signatureHelp.enabled": true,
    "java.signatureHelp.description.enabled": true,
    "java.edit.smartSemicolonDetection.enabled": true,
    "java.referencesCodeLens.enabled": false,
    "java.implementationCodeLens": "none",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.quickfix.showAt": "line",
    "java.settings.url": "${SUITE}/profiles/java/inspecoes.prefs",
    "java.format.settings.url": "${SUITE}/profiles/java/estilo.xml",
    "java.format.settings.profile": "IntelliJ",
    "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
    "java.codeGeneration.hashCodeEquals.useInstanceof": true,
    "java.codeGeneration.useBlocks": true,
    "java.typeHierarchy.lazyLoad": false,
    "java.eclipse.downloadSources": true,
    "java.maven.downloadSources": true,
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": false,
        "editor.snippetSuggestions": "none",
        "editor.suggest.localityBonus": true,
        "editor.suggest.showStatusBar": false
    },
    "java.debug.settings.console": "integratedTerminal",
    "java.debug.settings.hotCodeReplace": "auto",
    "java.debug.settings.enableRunDebugCodeLens": false,
    "java.debug.settings.showToString": true,
    "java.dependency.packagePresentation": "hierarchical",
    "java.dependency.enableDependencyCheckup": false
}
