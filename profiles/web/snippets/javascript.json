{
  "console.log": { "prefix": "clg", "body": ["console.log($1);"], "description": "Print to the console" },
  "console.error": { "prefix": "cle", "body": ["console.error($1);"], "description": "Print an error" },
  "function": { "prefix": "fn", "body": ["function ${1:name}($2) {", "    $0", "}"], "description": "Function" },
  "arrow": { "prefix": "afn", "body": ["const ${1:name} = ($2) => {", "    $0", "};"], "description": "Arrow function" },
  "query": { "prefix": "qs", "body": ["document.querySelector('$1')"], "description": "Query selector" },
  "listener": { "prefix": "ael", "body": ["${1:element}.addEventListener('${2:click}', (event) => {", "    $0", "});"], "description": "Event listener" },
  "for of": { "prefix": "forof", "body": ["for (const ${1:item} of ${2:items}) {", "    $0", "}"], "description": "For of" },
  "fetch": { "prefix": "ftc", "body": ["const response = await fetch('$1');", "const data = await response.json();", "$0"], "description": "Fetch JSON" }
}
