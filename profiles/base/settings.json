{
    "workbench.colorTheme": "Islands Dark",
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "property.static": {
                "foreground": "#C77DBB",
                "fontStyle": "italic"
            },
            "method.static": {
                "fontStyle": "italic"
            },
            "property": "#C77DBB"
        }
    },
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#26282C",
        "titleBar.inactiveBackground": "#26282C",
        "activityBar.background": "#26282C",
        "statusBar.background": "#26282C",
        "statusBar.noFolderBackground": "#26282C",
        "sideBar.background": "#191A1C",
        "sideBarSectionHeader.background": "#191A1C",
        "panel.background": "#191A1C",
        "terminal.background": "#191A1C",
        "editorGroupHeader.tabsBackground": "#191A1C",
        "tab.inactiveBackground": "#191A1C",
        "sideBar.border": "#26282C",
        "panel.border": "#26282C",
        "titleBar.border": "#26282C",
        "activityBar.border": "#26282C",
        "statusBar.border": "#26282C",
        "editorGroup.border": "#26282C",
        "editor.lineHighlightBackground": "#1F2024",
        "editor.stackFrameHighlightBackground": "#2E4D89",
        "editor.focusedStackFrameHighlightBackground": "#2E4D89",
        "editorInlayHint.foreground": "#7A7E85",
        "editor.inlineValuesForeground": "#7A7E85",
        "editor.inlineValuesBackground": "#00000000",
        "editorLineNumber.activeForeground": "#BCBEC4",
        "tab.activeBackground": "#233558",
        "tab.activeBorder": "#00000000",
        "tab.border": "#191A1C",
        "tab.activeForeground": "#FFFFFF"
    },
    "workbench.iconTheme": "jetbrains-file-icon-theme-auto",
    "workbench.productIconTheme": "jetbrains-product-icon-theme",
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontSize": 13,
    "editor.lineHeight": 1.2,
    "editor.fontLigatures": false,
    "terminal.integrated.fontFamily": "JetBrains Mono",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "args": [
                "--rcfile",
                "${SUITE}/profiles/base/terminal.bashrc"
            ],
            "icon": "terminal-bash"
        }
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.shellIntegration.enabled": false,
    "debug.terminal.clearBeforeReusing": true,
    "terminal.integrated.lineHeight": 1.1,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.tabs.hideCondition": "singleTerminal",
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.scrollback": 5000,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.enableImages": false,
    "terminal.integrated.copyOnSelection": false,
    "terminal.integrated.rightClickBehavior": "default",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.allowMnemonics": false,
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.quickOpen",
        "-workbench.action.quickOpenView",
        "-workbench.action.showAllSymbols",
        "workbench.view.explorer",
        "workbench.view.scm",
        "workbench.view.debug",
        "workbench.actions.view.problems",
        "outline.focus",
        "java.debug.runJavaFile",
        "java.debug.debugJavaFile",
        "java.workspace.compile",
        "ij.run",
        "ij.runSelected",
        "ij.debugSelected",
        "ij.rerun",
        "ij.stop",
        "workbench.action.debug.stop",
        "workbench.action.debug.restart"
    ],
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,
    "window.title": "${rootName}",
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.navigationControl.enabled": false,
    "workbench.activityBar.compact": true,
    "workbench.layoutControl.enabled": false,
    "workbench.activity.showAccounts": false,
    "workbench.sideBar.location": "left",
    "workbench.panel.defaultLocation": "bottom",
    "workbench.startupEditor": "none",
    "chat.disableAIFeatures": true,
    "workbench.panel.opensMaximized": "never",
    "explorer.autoReveal": true,
    "diffEditor.renderSideBySide": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "debug.internalConsoleOptions": "neverOpen",
    "debug.openDebug": "openOnDebugBreak",
    "debug.openExplorerOnEnd": true,
    "testing.automaticallyOpenTestResults": "openOnTestFailure",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.tree.indent": 16,
    "explorer.compactFolders": false,
    "breadcrumbs.enabled": false,
    "files.autoSave": "onFocusChange",
    "files.encoding": "utf8",
    "editor.minimap.enabled": false,
    "editor.rulers": [
        120
    ],
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.guides.bracketPairs": false,
    "editor.guides.highlightActiveIndentation": false,
    "editor.lightbulb.enabled": "off",
    "errorLens.enabled": false,
    "workbench.editor.decorations.badges": false,
    "workbench.editor.decorations.colors": false,
    "editor.inlayHints.enabled": "on",
    "editor.linkedEditing": true,
    "editor.mouseWheelZoom": true,
    "editor.suggest.insertMode": "replace",
    "editor.suggestSelection": "first",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.tabCompletion": "on",
    "editor.snippetSuggestions": "bottom",
    "editor.wordBasedSuggestions": "off",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.foldingImportsByDefault": true,
    "editor.showFoldingControls": "always",
    "editor.renderLineHighlight": "line",
    "editor.cursorWidth": 2,
    "editor.cursorSmoothCaretAnimation": "explicit",
    "editor.cursorBlinking": "smooth",
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.hideCursorInOverviewRuler": true,
    "editor.hover.delay": 500,
    "search.quickOpen.includeSymbols": true,
    "debug.toolBarLocation": "docked",
    "debug.inlineValues": "on",
    "workbench.localHistory.enabled": true,
    "workbench.localHistory.maxFileEntries": 100,
    "scm.defaultViewMode": "tree",
    "git.blame.statusBarItem.enabled": true,
    "files.exclude": {
        "**/out": true
    },
    "files.watcherExclude": {
        "**/out/**": true,
        "**/bin/**": true,
        "**/target/**": true,
        "**/build/**": true,
        "**/.gradle/**": true,
        "**/node_modules/**": true,
        "**/.git/objects/**": true
    },
    "search.exclude": {
        "**/out": true,
        "**/bin": true,
        "**/target": true,
        "**/build": true,
        "**/node_modules": true
    },
    "telemetry.telemetryLevel": "off",
    "redhat.telemetry.enabled": false,
    "extensions.ignoreRecommendations": true,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "telemetry.feedback.enabled": false,
    "telemetry.editStats.enabled": false,
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "update.mode": "none",
    "update.showReleaseNotes": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "workbench.cloudChanges.continueOn": "off",
    "workbench.cloudChanges.autoResume": "off",
    "npm.fetchOnlinePackageInfo": false,
    "json.schemaDownload.enable": false,
    "typescript.disableAutomaticTypeAcquisition": true
}