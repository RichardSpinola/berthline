{
  "name": "berthline-web",
  "displayName": "Berthline Web",
  "description": "Run, debug and live preview for the Berthline Web profile",
  "version": "0.3.1",
  "publisher": "berthline",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:berthline.preview"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "web.preview",
        "title": "Open Preview",
        "category": "Web",
        "icon": "$(open-preview)"
      },
      {
        "command": "web.stopPreview",
        "title": "Stop Preview",
        "category": "Web",
        "icon": "$(debug-stop)"
      },
      {
        "command": "web.previewMenu",
        "title": "Preview Options",
        "category": "Web"
      },
      {
        "command": "web.insertBlock",
        "title": "Insert Block",
        "category": "Web",
        "icon": "$(layout)"
      },
      {
        "command": "web.run",
        "title": "Run",
        "icon": "$(play)"
      },
      {
        "command": "web.debug",
        "title": "Debug",
        "icon": "$(bug)"
      },
      {
        "command": "web.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "web.rerun",
        "title": "Rerun"
      },
      {
        "command": "web.search",
        "title": "Search Everywhere",
        "icon": "$(search)"
      },
      {
        "command": "web.settings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "web.customizeBackground",
        "title": "Customize Editor Background"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "web.preview",
          "group": "navigation@-4",
          "when": "editorLangId == html && !web.previewOpen"
        },
        {
          "command": "web.run",
          "group": "navigation@-3",
          "when": "editorLangId == javascript || editorLangId == typescript"
        },
        {
          "command": "web.debug",
          "group": "navigation@-2",
          "when": "editorLangId == html || editorLangId == javascript || editorLangId == typescript"
        },
        {
          "command": "web.stop",
          "group": "navigation@-1",
          "when": "inDebugMode || web.emExecucao"
        }
      ],
      "editor/context": [
        {
          "command": "web.insertBlock",
          "group": "1_modification@9",
          "when": "editorLangId == html"
        }
      ],
      "explorer/context": [
        {
          "command": "web.preview",
          "group": "navigation@9",
          "when": "resourceExtname == .html || resourceExtname == .htm"
        }
      ]
    },
    "configuration": {
      "title": "Web",
      "properties": {
        "web.preview.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the preview beside the editor by itself when the folder has an index.html. Off by default: the preview costs about 100 MB of memory."
        }
      }
    }
  }
}
